  <equality>
    <joint joint1="left_finger" joint2="right_finger" polycoef="0 -1 0 0 0"/>
    <!-- 나사산(bolt_slide=f(bolt_hinge))도 처음엔 여기 equality로 넣었었다.
         그런데 회전을 전혀 안 시키고 중력만 줘봤더니(bolt_hinge_drive
         ctrl=0으로 고정) bolt_hinge는 거의 안 움직이는데 bolt_slide만
         혼자 중력으로 끝까지(0.034) 미끄러져 내려가는 걸 실측으로 발견했다
         -- polycoef를 1.0으로 키워도, solref/solimp를 훨씬 강하게 줘도,
         두 조인트를 아예 다른(부모-자식) body로 분리해도 똑같았다. 즉
         이 조합에서 <equality><joint>가 외력(중력)에 저항하는 용도로는
         안 먹힌다는 뜻 -- wrist_rotate<->bolt_hinge 결합 때 겪은 것과
         근본적으로 같은 종류의 문제로 보고, 같은 해법(전용 액추에이터 +
         코드에서 값 대입)으로 바꿨다. 아래 actuator의 bolt_slide_drive 참고. -->

    <!-- 드라이버 집기(grasp): 실제 손가락 접촉/마찰로 쥐는 물리는 다루지
         않고(이 파일의 다른 이상화들과 같은 결정), 팔이 픽업 자세에
         도달하고 손가락을 닫는 순간 코드에서 이 weld를 active=1로 켜서
         "그리퍼가 드라이버를 쥐고 있다"를 흉내낸다. relpose(0.13,0,0,
         무회전)는 원래 driver가 gripper_link의 자식이었을 때의 고정
         오프셋과 정확히 같다 -- 그래서 weld가 켜진 이후로는 이전에
         검증된 나사 조이기 시퀀스(target_offset 계산, z-추종 등)가
         전혀 손 댈 필요 없이 그대로 작동한다. -->
    <weld name="driver_grasp" body1="gripper_link" body2="driver" relpose="0.13 0 0 1 0 0 0" active="false"/>
  </equality>

  <actuator>
    <position class="waist" name="waist" joint="waist"/>
    <position class="shoulder" name="shoulder" joint="shoulder"/>
    <position class="elbow" name="elbow" joint="elbow"/>
    <position class="forearm_roll" name="forearm_roll" joint="forearm_roll"/>
    <position class="wrist_angle" name="wrist_angle" joint="wrist_angle"/>
    <position class="wrist_rotate" name="wrist_rotate" joint="wrist_rotate"/>
    <position class="finger" name="gripper" joint="left_finger"/>
    <!-- 드라이버-볼트 결합: wrist_rotate와 별개의, bolt 자체 스케일에 맞는
         작은 position actuator. 매 스텝 컨트롤 코드가 이 ctrl을
         wrist_rotate의 qpos(또는 목표각)로 그대로 복사해서 "물려서 같이
         돈다"를 구현한다. kp를 크게 줘도 bolt 관성이 작아 계산이 안정적 --
         팔 전체와 직접 equality로 묶었을 때완 다르게, 이 작은 액추에이터의
         actuatorfrc가 곧 "볼트를 돌리는 데 필요한 토크"라서 저항 피드백
         센서로 그대로 쓸 수 있다. -->
    <position name="bolt_hinge_drive" joint="bolt_hinge" kp="2" forcerange="-2 2"/>
    <!-- 나사산 구동: 매 스텝 컨트롤 코드가 ctrl = pitch_per_rad * bolt_hinge
         현재값으로 계산해서 대입한다(피치 0.002m/rev -> pitch_per_rad =
         0.002/(2*pi) = 0.00031831). kp=100 정도는 돼야 중력 처짐이
         실측상 1mm 이내로 억제된다(kp=20 근처에서는 3mm 가까이 처짐). -->
    <position name="bolt_slide_drive" joint="bolt_slide" kp="100" forcerange="-5 5"/>
  </actuator>

  <contact>
    <exclude body1="base_link" body2="shoulder_link"/>
  </contact>

  <sensor>
    <!-- 토크 피드백: bolt_hinge_drive 액추에이터가 실제로 내고 있는
         힘(=구동 토크). 볼트의 저항(frictionloss + seat 접촉)이 커질수록
         이 값이 커진다. -->
    <actuatorfrc name="bolt_drive_torque" actuator="bolt_hinge_drive"/>
    <jointpos name="bolt_slide_pos" joint="bolt_slide"/>
    <jointpos name="bolt_hinge_pos" joint="bolt_hinge"/>
  </sensor>
</mujoco>
