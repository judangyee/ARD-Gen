         시나리오 중 2개가 실패했다. solref="0.002 1"/solimp="0.95 0.99
         0.0001 0.5 2"로 강화하고 같은 크기의 합성 힘(2,2,-5N)을 걸어
         비교해보니 300스텝 방치 변위가 80mm대에서 3~4mm대로 줄었다
         (실측 확인) -- screw_driving.xml에서 겪은 "이 프로젝트 규모에서
         solref/solimp를 강하게 줘도 equality가 힘에 안 버틴다"는
         경험칙과 달리, 여기서는(weld, 6-DOF 전체 구속이라 여러 자유도가
         동시에 저항해서인지) 실제로 효과가 있었다. -->
    <weld name="hole_grasp" body1="gripper_link_l" body2="hole_socket"
          relpose="-0.0302036 0.0000007 -0.0252713 -0.00120468 -0.70710705 -0.70710446 -0.00120468"
          solref="0.002 1" solimp="0.95 0.99 0.0001 0.5 2"
          active="true"/>
  </equality>

  <actuator>
    <position class="waist" name="waist" joint="waist"/>
    <position class="shoulder" name="shoulder" joint="shoulder"/>
    <position class="elbow" name="elbow" joint="elbow"/>
    <position class="forearm_roll" name="forearm_roll" joint="forearm_roll"/>
    <position class="wrist_angle" name="wrist_angle" joint="wrist_angle"/>
    <position class="wrist_rotate" name="wrist_rotate" joint="wrist_rotate"/>
    <position class="finger" name="gripper" joint="left_finger"/>

    <position class="waist" name="waist_l" joint="waist_l"/>
    <position class="shoulder" name="shoulder_l" joint="shoulder_l"/>
    <position class="elbow" name="elbow_l" joint="elbow_l"/>
    <position class="forearm_roll" name="forearm_roll_l" joint="forearm_roll_l"/>
    <position class="wrist_angle" name="wrist_angle_l" joint="wrist_angle_l"/>
    <position class="wrist_rotate" name="wrist_rotate_l" joint="wrist_rotate_l"/>
    <position class="finger" name="gripper_l" joint="left_finger_l"/>
  </actuator>

  <contact>
    <exclude body1="base_link" body2="shoulder_link"/>
    <exclude body1="base_link_l" body2="shoulder_link_l"/>
  </contact>

  <sensor>
    <force name="peg_force" site="peg_tip_site"/>
    <torque name="peg_torque" site="peg_tip_site"/>
  </sensor>
</mujoco>
