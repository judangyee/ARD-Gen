<mujoco model="cap_twist">
  <!-- 병뚜껑(cap) 돌리기 태스크용 최소 모델.

  peg_in_hole.xml과 같은 단순화 전제: 오른팔 end-effector가 cap을 이미
  강체로 그립하고 있다고 가정하고, 그립/팔 기구학 자체는 모델링하지
  않는다(assets/peg_in_hole.xml이 팔 6조인트를 실제로 모델링하는 것과 달리,
  이 태스크는 "손목 회전 = cap 회전"이 1:1이라 별도 팔이 필요 없다) -- 그래서
  bottle을 world에 고정하고, cap을 z축 힌지 하나로 붙인 뒤 그 힌지를 위치
  액추에이터로 직접 구동한다(액추에이터 ctrl이 곧 sim/cap_twist_env.py의
  손목 목표각).

  ## 회전 저항을 frictionloss가 아니라 dof_damping(속도 비례)으로 모델링하는 이유

  처음에는 "안 열려본 병" 저항을 건마찰(Coulomb, hinge frictionloss)로
  모델링했다 -- 그런데 실측해보니(sim/cap_twist_env.py 개발 중 직접 스윕
  테스트) Coulomb 저항은 속도와 거의 무관하게 거의 일정한 토크를 요구해서,
  admittance controller가 회전 속도를 늦춰도(Kp_tau를 올려도) 필요 토크가
  거의 안 줄어들었다 -- 즉 Kp_tau가 사실상 아무 得이 없고 "무조건 작을수록
  좋다"는 시시한 최적화 문제가 됐다(리워드가 Kp_tau에 대해 거의 단조
  감소). 실제 admittance control이 의미를 가지려면 "느리게 돌리면 필요한
  토크가 실제로 줄어드는" 속도-의존 저항이어야 한다 -- 그래서 저항을
  hinge의 dof_damping(토크 = damping * 각속도)으로 표현했다. frictionloss는
  아주 작은 고정값(정지 시 채터링 방지용)만 남기고 scene_config로
  덮어쓰지 않는다.

  scene_config의 resistance_torque(N*m)는 "기본 각속도(OMEGA_BASE)로 돌릴 때
  필요한 토크"로 정의하고, sim/cap_twist_env.py에서
  damping = resistance_torque / OMEGA_BASE로 환산해 dof_damping에 대입한다
  (peg_in_hole.xml의 geom_friction을 런타임에 덮어쓰는 것과 같은 패턴) --
  이러면 저항이 세질수록(damping 증가) Kp_tau로 속도를 늦추는 게 실제로
  필요 토크를 낮춰주므로, "너무 작으면 걸림(stuck) 반복, 너무 크면 진행이
  느려짐"이라는 peg-in-hole의 Kp_xy와 같은 성질의(양쪽에서 나쁜) 탐색
  문제가 된다.

  ## jointactuatorfrc 센서 = "토크 센서"

  실제 F/T 센서(peg_in_hole의 force/torque site sensor)처럼 접촉력을 재는
  게 아니라, 힌지에 작용하는 액추에이터 토크 자체를 잰다 -- "손목이 cap을
  돌리기 위해 지금 얼마나 힘을 주고 있는가"가 곧 사용자가 손목에서
  느끼는 반작용 토크이므로, admittance controller의 tau_measured 입력으로
  정확히 대응된다.

  ## actuator forcerange = 그립이 슬립 없이 전달할 수 있는 최대 토크

  이 이상 토크가 필요해지면(즉 뚜껑이 걸려서 안 돌아가면) 실제로는 손목이
  헛돌거나 그립이 미끄러지는 상황이다. sim/cap_twist_env.py의
  stuck-detection(TAU_STUCK_THRESHOLD)이 이 한계에 도달하기 전에 먼저
  반응해서 살짝 역회전 후 재시도하도록, 한계보다 낮은 값으로 설정돼 있다.
  -->
  <compiler angle="radian"/>
  <option timestep="0.002" integrator="implicitfast" gravity="0 0 -9.81"/>

  <asset>
    <!-- RoboTwin 2.0 이식 Part 1(시각 domain randomization):
         peg_in_hole_bimanual_openarm.xml/tacker_openarm.xml과 이름까지
         동일한 재질 팔레트 -- sim/visual_randomization.py가 공통으로
         동작한다(이 파일에는 원래 ground/장식 table이 없어서 이번에
         같은 이름 규칙으로 새로 추가했다, 아래 worldbody 주석 참고). -->
    <texture name="ground_tex_0" type="2d" builtin="checker" rgb1="0.5 0.5 0.52" rgb2="0.4 0.4 0.42" width="64" height="64"/>
    <material name="ground_mat_0" texture="ground_tex_0" texrepeat="4 4" reflectance="0.1"/>
    <texture name="ground_tex_1" type="2d" builtin="checker" rgb1="0.45 0.42 0.38" rgb2="0.3 0.28 0.25" width="64" height="64"/>
    <material name="ground_mat_1" texture="ground_tex_1" texrepeat="6 6" reflectance="0.05"/>
    <texture name="ground_tex_2" type="2d" builtin="gradient" rgb1="0.55 0.6 0.65" rgb2="0.25 0.28 0.32" width="64" height="64"/>
    <material name="ground_mat_2" texture="ground_tex_2" reflectance="0.0"/>

    <texture name="table_tex_0" type="2d" builtin="checker" rgb1="0.55 0.4 0.3" rgb2="0.45 0.32 0.24" width="64" height="64"/>
    <material name="table_mat_0" texture="table_tex_0" texrepeat="3 3" reflectance="0.1"/>
    <texture name="table_tex_1" type="2d" builtin="checker" rgb1="0.6 0.55 0.5" rgb2="0.4 0.36 0.3" width="64" height="64"/>
    <material name="table_mat_1" texture="table_tex_1" texrepeat="2 2" reflectance="0.15"/>
    <texture name="table_tex_2" type="2d" builtin="gradient" rgb1="0.5 0.35 0.25" rgb2="0.25 0.18 0.12" width="64" height="64"/>
    <material name="table_mat_2" texture="table_tex_2" reflectance="0.05"/>
  </asset>

  <worldbody>
    <light pos="0 0 1" dir="0 0 -1" diffuse="0.8 0.8 0.8"/>
    <!-- RoboTwin 2.0 이식 Part 1: 조명 randomization이 "첫 2개 light"를
         공통으로 다루므로(sim/visual_randomization.py._apply_lights는
         실제로는 model.nlight 전부를 돈다 -- 개수와 무관하게 동작하지만,
         다른 두 태스크와 조명 다양성을 맞추려고 2번째 light를 추가했다).
         물리(동역학)에는 light가 전혀 영향을 주지 않는다. -->
    <light pos="0.3 -0.2 0.8" dir="-0.3 0.2 -0.6" diffuse="0.4 0.4 0.4"/>

    <!-- bottle이 실제로 올라서는 충돌 평면 -- 이름을 "table"에서
         floor_contact로 바꿨을 뿐(물리/코드 어디서도 이름으로 참조하지
         않는 것을 grep으로 확인) 지오메트리/물성은 전혀 안 바꿨다.
         "table"이라는 이름은 아래 순수 시각용 장식 table 바디에 쓴다
         (peg_in_hole/tacker와 공통 이름 규칙을 맞추기 위해) --
         sim/visual_randomization.py는 이 floor_contact를 전혀 모르고,
         절대 건드리지 않는다(물리 파라미터 독립성, 그 모듈 docstring
         참고). -->
    <geom name="floor_contact" type="plane" size="0.3 0.3 0.02" pos="0 0 0" contype="1" conaffinity="1"
          friction="1.0 0.005 0.0001" rgba="0.9 0.9 0.9 1"/>

    <!-- 순수 시각 장식(충돌 없음) -- peg_in_hole_bimanual_openarm.xml의
         ground/table과 완전히 같은 이름 규칙. floor_contact보다 살짜기
         아래(z=-0.001)에 둬서 겹치는 평면끼리 깜빡이는 걸(z-fighting)
         피했다. -->
    <geom name="ground" type="plane" pos="0 0 -0.001" size="0.5 0.5 0.01" contype="0" conaffinity="0" material="ground_mat_0" rgba="0.5 0.5 0.52 1"/>

    <!-- RoboTwin 2.0 이식 Part 1: clutter 슬롯(다른 두 태스크와 동일
         패턴/이름) -- cap_twist 작업공간이 작아서(floor 반경 0.3m)
         구석 좌표를 그만큼 줄였다. contype=0이라 bottle/cap 물리와는
         무관. -->
    <body name="clutter_0" pos="-0.22 -0.22 0">
      <geom name="clutter_0_geom" type="box" size="0.02 0.02 0.02" contype="0" conaffinity="0" rgba="0.5 0.5 0.5 1"/>
    </body>
    <body name="clutter_1" pos="-0.22 0.22 0">
      <geom name="clutter_1_geom" type="box" size="0.02 0.02 0.02" contype="0" conaffinity="0" rgba="0.5 0.5 0.5 1"/>
    </body>
    <body name="clutter_2" pos="0.22 -0.22 0">
      <geom name="clutter_2_geom" type="box" size="0.02 0.02 0.02" contype="0" conaffinity="0" rgba="0.5 0.5 0.5 1"/>
    </body>

    <!-- 순수 시각 장식 table(충돌 없음) -- bottle(원점)과 안 겹치게
         구석(0.2, 0.2)에 작게 뒀다. 다른 두 태스크의 "table" 패턴과
         이름을 맞췄다(table_top/table_leg_1..4) -- sim/
         visual_randomization.py가 공통으로 인식한다. -->
    <body name="table" pos="0.2 0.2 0">
      <geom name="table_top" type="box" pos="0 0 0.1" size="0.06 0.06 0.01" contype="0" conaffinity="0" material="table_mat_0" rgba="0.55 0.4 0.3 1"/>
      <geom name="table_leg_1" type="box" pos="0.045 0.045 0.05" size="0.006 0.006 0.05" contype="0" conaffinity="0" rgba="0.35 0.25 0.18 1"/>
      <geom name="table_leg_2" type="box" pos="-0.045 0.045 0.05" size="0.006 0.006 0.05" contype="0" conaffinity="0" rgba="0.35 0.25 0.18 1"/>
      <geom name="table_leg_3" type="box" pos="0.045 -0.045 0.05" size="0.006 0.006 0.05" contype="0" conaffinity="0" rgba="0.35 0.25 0.18 1"/>
      <geom name="table_leg_4" type="box" pos="-0.045 -0.045 0.05" size="0.006 0.006 0.05" contype="0" conaffinity="0" rgba="0.35 0.25 0.18 1"/>
    </body>

    <!-- cap_twist는 팔을 모델링하지 않아 "손목 카메라"가 없다(모듈
         docstring 참고) -- 외부 카메라만 추가한다. render_episode.py는
         이전에는 이 태스크에 이름 있는 카메라가 없어서 자유 시점으로
         대체했는데(그 파일 _NAMED_CAMERAS 주석 참고), 이제 다른 두
         태스크와 같은 이름(top_cam)을 쓸 수 있다. -->
    <camera name="wide_cam" mode="targetbody" target="bottle" pos="0.5 0.3 0.4"/>
    <camera name="top_cam" mode="targetbody" target="bottle" pos="0.05 0.0 0.35"/>

    <!-- bottle: 3단계부터 freejoint(자유물체)다 -- 왼팔(Stabilizer)이 이
         물체를 쥐는 역할을 하려면 cap을 돌릴 때 생기는 반작용 토크에
         밀리거나 같이 돌 수 있어야 하기 때문(world-고정이면 Stabilizer가
         있으나 없으나 물리가 똑같아서 존재 의미가 없다). -->
    <body name="bottle" pos="0 0 0">
      <freejoint name="bottle_free"/>
      <inertial pos="0 0 0.06" mass="0.3" diaginertia="1.5e-4 1.5e-4 1.5e-4"/>
      <geom name="bottle_body" type="cylinder" size="0.03 0.06" pos="0 0 0.06"
            contype="1" conaffinity="1" friction="1.0 0.005 0.0001" rgba="0.25 0.45 0.7 1"/>

      <body name="cap" pos="0 0 0.12">
        <joint name="cap_hinge" type="hinge" axis="0 0 1" pos="0 0 0"
               damping="0.05" frictionloss="0.05" limited="false"/>
        <inertial pos="0 0 0" mass="0.3" diaginertia="1e-3 1e-3 1e-3"/>
        <geom name="cap_geom" type="cylinder" size="0.032 0.015" pos="0 0 0.015"
              contype="0" conaffinity="0" rgba="0.8 0.3 0.2 1"/>
        <site name="cap_grip_site" pos="0 0 0.015" size="0.005"/>
      </body>
    </body>

    <!-- Stabilizer(왼팔) 가상 엔드이펙터: assets/peg_in_hole.xml과 완전히 같은
         패턴/명명(stab_x/y/z, stabilizer_ee, stabilizer_weld) -- 두 태스크
         모두 sim/stabilizer.py 하나로 동일하게 다룰 수 있는 이유가 이것이다.
         자세한 설계 근거는 assets/peg_in_hole.xml의 같은 블록 주석 참고. -->
    <body name="stabilizer_ee" pos="0 0 0">
      <joint name="stab_x" type="slide" axis="1 0 0" damping="90"/>
      <joint name="stab_y" type="slide" axis="0 1 0" damping="90"/>
      <joint name="stab_z" type="slide" axis="0 0 1" damping="90"/>
      <inertial pos="0 0 0" mass="0.1" diaginertia="1e-5 1e-5 1e-5"/>
      <geom name="stabilizer_ee_geom" type="sphere" size="0.012" contype="0" conaffinity="0" rgba="0.2 0.8 0.3 1"/>
      <site name="stabilizer_ee_site" pos="0 0 0" size="0.005"/>
    </body>
  </worldbody>

  <equality>
    <weld name="stabilizer_weld" body1="stabilizer_ee" body2="bottle"
          solref="0.002 1" solimp="0.95 0.99 0.0001 0.5 2" active="false"/>
  </equality>

  <actuator>
    <!-- kp: 목표각 추종 강성. forcerange: 그립이 슬립 없이 낼 수 있는 최대 토크
         (sim/cap_twist_env.py의 TAU_STUCK_THRESHOLD보다 커야, 스턱 감지가
         이 한계에 도달하기 전에 먼저 트리거된다). -->
    <position name="cap_drive" joint="cap_hinge" kp="8.0" forcerange="-1.2 1.2"/>

    <position name="stab_x" joint="stab_x" kp="20000" forcerange="-3000 3000"/>
    <position name="stab_y" joint="stab_y" kp="20000" forcerange="-3000 3000"/>
    <position name="stab_z" joint="stab_z" kp="20000" forcerange="-3000 3000"/>
  </actuator>

  <sensor>
    <jointactuatorfrc name="cap_torque" joint="cap_hinge"/>
  </sensor>
</mujoco>
