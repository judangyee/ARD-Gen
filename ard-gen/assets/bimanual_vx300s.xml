  <equality>
    <joint joint1="left_finger" joint2="right_finger" polycoef="0 -1 0 0 0"/>
    <joint joint1="left_finger_l" joint2="right_finger_l" polycoef="0 -1 0 0 0"/>
    <!-- relpose/solref/solimp 값은 assets/peg_in_hole_bimanual.xml에서 이미
         실측 검증한 것을 그대로 재사용(목표 지점이 (0.10,0,0.0438) 무회전으로
         동일). -->
    <weld name="workpiece_grasp" body1="gripper_link_l" body2="workpiece"
          relpose="-0.0302036 0.0000007 -0.0252713 -0.00120468 -0.70710705 -0.70710446 -0.00120468"
          solref="0.002 1" solimp="0.95 0.99 0.0001 0.5 2"
          active="true"/>
  </equality>

  <actuator>
    <position class="waist" name="waist" joint="waist"/>
    <position class="shoulder" name="shoulder" joint="shoulder"/>
    <position class="elbow" name="elbow" joint="elbow"/>
    <position class="forearm_roll" name="forearm_roll" joint="forearm_roll"/>
    <position class="wrist_angle" name="wrist_angle" joint="wrist_angle"/>
    <position class="wrist_rotate" name="wrist_rotate" joint="wrist_rotate"/>
    <position class="finger" name="gripper" joint="left_finger"/>

    <!-- 왼팔은 kp를 오른팔 class 기본값의 ~10배로 올렸다 (근거는 파일 상단
         docstring 참고). -->
    <position name="waist_l" joint="waist_l" ctrlrange="-3.14158 3.14158" kp="250" forcerange="-100 100"/>
    <position name="shoulder_l" joint="shoulder_l" ctrlrange="-1.85005 1.25664" kp="760" forcerange="-200 200"/>
    <position name="elbow_l" joint="elbow_l" ctrlrange="-1.76278 1.6057" kp="1060" forcerange="-150 150"/>
    <position name="forearm_roll_l" joint="forearm_roll_l" ctrlrange="-3.14158 3.14158" kp="350" forcerange="-60 60"/>
    <position name="wrist_angle_l" joint="wrist_angle_l" ctrlrange="-1.8675 2.23402" kp="240" forcerange="-60 60"/>
    <position name="wrist_rotate_l" joint="wrist_rotate_l" ctrlrange="-3.14158 3.14158" kp="210" forcerange="-60 60"/>
    <position class="finger" name="gripper_l" joint="left_finger_l"/>
  </actuator>

  <contact>
    <exclude body1="base_link" body2="shoulder_link"/>
    <exclude body1="base_link_l" body2="shoulder_link_l"/>
  </contact>
</mujoco>
