<mujoco model="ard_gen_peg_in_hole_vx300s">
  <!--
    ARD-Gen 0단계(Seed 확보)용 peg-in-hole 모델. 실제 ALOHA 팔로워 팔인
    Trossen ViperX 300 6DOF(VX300s, mujoco_menagerie의 공식 MJCF,
    assets/vx300s/LICENSE 참고)를 그대로 가져다 쓰고, 그리퍼 끝에 peg를
    강체로 고정한 뒤 hole에 삽입한다.

    기구학 메모 (sim/peg_in_hole_sim.py가 그대로 가정하는 값들 — 바꾸면 sim도
    같이 고칠 것):
      - VX300s는 6개 회전 조인트(waist, shoulder, elbow, forearm_roll,
        wrist_angle, wrist_rotate) + 손가락 2개. sim은 이 중 peg tip 위치
        제어에 Jacobian 기반 damped-least-squares를 쓴다(2-link closed-form
        IK를 썼던 이전 프로젝트와 달리, 6-DOF라 닫힌 형태 해가 마땅치 않음).
      - "홈" 자세(waist=0, shoulder=-0.8924, elbow=1.0534, forearm_roll=0,
        wrist_angle=1.4093, wrist_rotate=0)는 그리퍼가 정확히 수직 아래를
        향하면서 base(월드 원점) 기준 수평 거리 10cm 지점에 오도록 그리드
        서치로 찾았다 — 이 자세에서 gripper_link의 로컬 +x축(핀치 방향)이
        world (0,0,-1)과 오차 0.0005 이내로 일치하고, pinch site는 world
        (0.10, 0, 0.144) 근처에 온다.
      - peg는 gripper_link의 자식으로, "pinch" site(로컬 (0.1,0,0), VX300s
        기본 제공 TCP)보다 로컬 +x 방향으로 0.07m 더 뻗어나간다(peg 바디
        pos 0.13 + 샤프트 반길이 0.03 + 구형 tip 반지름 0.01). 홈 자세에서
        peg tip world position ≈ (0.10, 0, 0.074).
      - hole opening 평면은 world z=0.0438 (홈 자세 peg tip 기준 3cm 아래
        호버 간격), 바닥은 hole_socket 로컬 z=-0.057이라 목표 삽입 깊이
        0.04m에 1.5cm 여유가 있다.
      - 카메라 2개 (render_result.py --cameras로 렌더링):
        - wrist_cam: gripper_link에 고정 장착, 그리퍼의 작동(삽입) 방향인
          로컬 +x축에 "수직"으로 시선을 둔다(로컬 -x/+z를 카메라 X/Y축으로
          잡아서 -z가 로컬 +y를 보게 함) — peg가 hole로 들어가는 걸 옆에서
          보는 프로파일 뷰. mode="fixed"라 그리퍼가 움직여도 이 상대 각도는
          안 바뀐다.
        - top_cam: mode="targetbody"target="hole_socket", world (0.28,0,0.32)
          에 고정 — 로봇 정면(+x, 팔이 뻗어나가는 방향)에서 로봇 쪽을
          마주보는 오블릭 앵글. base-hole 거리가 10cm로 짧아서 접힌
          upper_arm/forearm 링크가 hole 바로 위를 가리기 때문에, 순수 수직
          top view 대신 이 각도를 쓴다(실측 확인, 카메라 버그 아님).
      - shoulder/elbow는 frictionloss를 0으로 뺐다: 실측해보니 admittance
        controller 한 스텝의 위치 변화량이 실제 VX300s의 정지마찰 임계값보다
        작아서 조인트가 아예 안 움직이는 문제가 있었다(README 검증 섹션 참고).
      - 팔의 각 바디에는 gravcomp="1"을 줘서 실제 로봇 무게 아래에서도
        position controller가 자체 중력과 싸우지 않게 했다(실측해보니
        gravcomp 없이는 이 pose에서 팔이 눈에 띄게 처졌다).
      - fingers(left_finger/right_finger)는 grasp를 다루지 않으므로
        키프레임 기본값 근처로 고정해두기만 한다 (peg는 gripper_link에
        용접되듯 붙어 있어서 실제로 손가락이 peg를 쥐는 물리는 없음).
  -->
  <compiler angle="radian" meshdir="vx300s/assets" texturedir="vx300s/assets" autolimits="true"/>
  <!-- integrator="implicitfast": 3단계(Stabilizer)에서 hole_socket이 freejoint +
       weld을 갖게 되면서 추가됐다. 다른 태스크(screw_driving_bimanual_openarm.xml)
       에서 이미 겪은 문제 -- 기본 세미암시적 오일러 적분기는 "강한 위치
       액추에이터 + weld" 조합에서 긴 에피소드 동안 서서히 에너지가 새서
       처지는(drift) 버그가 있었다(그 태스크의 git log 참고) -- 를 여기서도
       선제적으로 피한다. 오른팔 단독(Stabilizer 없음) 회귀 테스트로 이
       적분기 교체 자체가 기존 성공률에 영향을 안 주는지 별도 확인함
       (sim/peg_in_hole_env.py의 3단계 관련 검증 결과 참고).-->
  <option cone="elliptic" impratio="10" integrator="implicitfast"/>
  <visual>
    <headlight ambient="0.4 0.4 0.4" diffuse="0.6 0.6 0.6" specular="0.1 0.1 0.1"/>
  </visual>

  <asset>
    <texture type="2d" file="interbotix_black.png"/>
    <material name="black" texture="interbotix_black"/>

    <mesh file="vx300s_1_base.stl" scale="0.001 0.001 0.001"/>
    <mesh file="vx300s_2_shoulder.stl" scale="0.001 0.001 0.001"/>
    <mesh file="vx300s_3_upper_arm.stl" scale="0.001 0.001 0.001"/>
    <mesh file="vx300s_4_upper_forearm.stl" scale="0.001 0.001 0.001"/>
    <mesh file="vx300s_5_lower_forearm.stl" scale="0.001 0.001 0.001"/>
    <mesh file="vx300s_6_wrist.stl" scale="0.001 0.001 0.001"/>
    <mesh file="vx300s_7_gripper.stl" scale="0.001 0.001 0.001"/>
    <mesh file="vx300s_8_gripper_prop.stl" scale="0.001 0.001 0.001"/>
    <mesh file="vx300s_9_gripper_bar.stl" scale="0.001 0.001 0.001"/>
    <mesh file="vx300s_10_gripper_finger.stl" scale="0.001 0.001 0.001"/>
  </asset>

  <default>
    <default class="vx300s">
      <joint axis="0 1 0"/>
      <position forcerange="-35 35"/>
      <default class="waist">
        <joint axis="0 0 1" range="-3.14158 3.14158" damping="2.86"/>
        <position ctrlrange="-3.14158 3.14158" kp="25"/>
      </default>
      <default class="shoulder">
        <!-- frictionloss(정지마찰)는 0으로 뺐다: 실측해보니 admittance
             controller의 스텝당 위치 변화량이 이 정지마찰 임계값보다 작아서
             조인트가 아예 안 움직이는 문제가 있었다 (README 검증 섹션 참고). -->
        <joint range="-1.85005 1.25664" armature="0.004" damping="6.25"/>
        <position ctrlrange="-1.85005 1.25664" kp="76" forcerange="-57 57"/>
      </default>
      <default class="elbow">
        <joint range="-1.76278 1.6057" armature="0.072" damping="8.15"/>
        <position ctrlrange="-1.76278 1.6057" kp="106" forcerange="-25 25"/>
      </default>
      <default class="forearm_roll">
        <joint axis="1 0 0" range="-3.14158 3.14158" armature="0.060" damping="3.07"/>
        <position ctrlrange="-3.14158 3.14158" kp="35" forcerange="-10 10"/>
      </default>
      <default class="wrist_angle">
        <joint range="-1.8675 2.23402" damping="1.18"/>
        <position ctrlrange="-1.8675 2.23402" kp="8"/>
      </default>
      <default class="wrist_rotate">
        <joint axis="1 0 0" range="-3.14158 3.14158" damping="0.78"/>
        <position ctrlrange="-3.14158 3.14158" kp="7"/>
      </default>
      <default class="finger">
        <joint type="slide" armature="0.251" damping="10"/>
        <position ctrlrange="0.021 0.057" kp="300"/>
        <default class="left_finger">
          <joint range="0.021 0.057"/>
        </default>
        <default class="right_finger">
          <joint range="-0.057 -0.021"/>
        </default>
      </default>
      <default class="visual">
        <geom type="mesh" contype="0" conaffinity="0" density="0" group="2" material="black"/>
      </default>
      <default class="collision">
        <geom group="3" type="mesh" contype="0" conaffinity="0"/>
      </default>
    </default>
    <default class="peg_contact">
      <geom contype="1" conaffinity="1" condim="4" friction="0.5 0.01 0.001" solref="0.002 1" solimp="0.9 0.95 0.001"/>
    </default>
  </default>

  <worldbody>
    <light pos="0.4 0 1" dir="0 0 -1" diffuse="0.8 0.8 0.8"/>
    <light pos="0.7 -0.4 0.5" dir="-0.4 0.4 -0.7" diffuse="0.4 0.4 0.4"/>

    <!-- 시각적 참조용 바닥 (충돌 없음, 아래 hole_table과 별개) -->
    <geom name="ground" type="plane" pos="0 0 -0.05" size="0.8 0.8 0.01" contype="0" conaffinity="0" rgba="0.5 0.5 0.52 1"/>

    <!-- 3단계(Stabilizer): hole_socket을 freejoint로 바꾸면서 실제로 얹혀 쉴
         충돌 가능한 테이블면이 필요해졌다(이전엔 world-고정 body라 아무것도
         받쳐줄 필요가 없었음). z=-0.0152는 hole_socket이 기존 고정 위치
         (0.10,0,0.0438)에 있을 때 hole_floor 바닥면의 world z 좌표와
         정확히 같다(0.0438 + hole_floor pos.z(-0.057) - half_thickness(0.002))
         -- 즉 이 테이블에 얹으면 기존 단일팔 검증에서 쓰던 것과 동일한
         위치/높이에서 시작한다(초기 낙하/settling 없음, sim/peg_in_hole_sim.py
         reset()이 짧게 물리를 재워 잔류 침투만 정리함). -->
    <geom name="hole_table" type="plane" pos="0 0 -0.0152" size="0.8 0.8 0.01"
          contype="1" conaffinity="1" friction="1.0 0.005 0.0001" rgba="0.6 0.5 0.4 1"/>

    <!-- 오블릭 탑 뷰 카메라: 로봇 정면(+x)에서 로봇 쪽을 마주보며 hole을
         내려다본다 (world 고정). 자세한 이유는 파일 상단 주석 참고. -->
    <camera name="top_cam" mode="targetbody" target="hole_socket" pos="0.28 0 0.32"/>

    <!-- Hole: 3단계(Stabilizer)부터 freejoint(자유물체)다 -- 왼팔이 이 물체를
         쥐는 역할을 하려면 물리적으로 밀리거나 돌아갈 수 있어야 하기 때문
         (world-고정이면 Stabilizer가 있으나 없으나 물리가 똑같아서 존재
         의미가 없다). clearance는 여전히 sim이 런타임에 geom_pos/geom_size를
         덮어써서 바꾼다. -->
    <body name="hole_socket" pos="0.10 0 0.0438">
      <freejoint name="hole_socket_free"/>
      <inertial pos="0 0 -0.0275" mass="0.2" diaginertia="2e-4 2e-4 2e-4"/>
      <geom class="peg_contact" name="hole_wall_px" type="box" pos="0.0155 0 -0.0275" size="0.004 0.0195 0.0275" rgba="0.55 0.55 0.6 1"/>
      <geom class="peg_contact" name="hole_wall_nx" type="box" pos="-0.0155 0 -0.0275" size="0.004 0.0195 0.0275" rgba="0.55 0.55 0.6 1"/>
      <geom class="peg_contact" name="hole_wall_py" type="box" pos="0 0.0155 -0.0275" size="0.0195 0.004 0.0275" rgba="0.55 0.55 0.6 1"/>
      <geom class="peg_contact" name="hole_wall_ny" type="box" pos="0 -0.0155 -0.0275" size="0.0195 0.004 0.0275" rgba="0.55 0.55 0.6 1"/>
      <geom class="peg_contact" name="hole_floor" type="box" pos="0 0 -0.057" size="0.0115 0.0115 0.002" rgba="0.55 0.55 0.6 1"/>
      <site name="hole_center_site" pos="0 0 0" size="0.002" rgba="1 0 0 0.5"/>
    </body>

    <body name="base_link" childclass="vx300s">
      <inertial pos="-0.0534774 -0.000562575 0.0205961" quat="-0.00292324 0.712517 0.00480387 0.701633" mass="0.969034"
        diaginertia="0.0071633 0.00602451 0.00169819"/>
      <geom quat="1 0 0 1" class="visual" mesh="vx300s_1_base"/>
      <body name="shoulder_link" pos="0 0 0.079" gravcomp="1">
        <inertial pos="0.000259233 -3.3552e-06 0.0116129" quat="-0.476119 0.476083 0.52279 0.522826" mass="0.798614"
          diaginertia="0.00120156 0.00113744 0.0009388"/>
        <joint name="waist" class="waist"/>
        <geom pos="0 0 -0.003" quat="1 0 0 1" class="visual" mesh="vx300s_2_shoulder"/>
        <body name="upper_arm_link" pos="0 0 0.04805" gravcomp="1">
          <inertial pos="0.0206949 4e-10 0.226459" quat="0 0.0728458 0 0.997343" mass="0.792592"
            diaginertia="0.00911338 0.008925 0.000759317"/>
          <joint name="shoulder" class="shoulder"/>
          <geom quat="1 0 0 1" class="visual" mesh="vx300s_3_upper_arm"/>
          <body name="upper_forearm_link" pos="0.05955 0 0.3" gravcomp="1">
            <inertial pos="0.105723 0 0" quat="-0.000621631 0.704724 0.0105292 0.709403" mass="0.322228"
              diaginertia="0.00144107 0.00134228 0.000152047"/>
            <joint name="elbow" class="elbow"/>
            <geom class="visual" mesh="vx300s_4_upper_forearm"/>
            <body name="lower_forearm_link" pos="0.2 0 0" gravcomp="1">
              <inertial pos="0.0513477 0.00680462 0" quat="-0.702604 -0.0796724 -0.702604 0.0796724" mass="0.414823"
                diaginertia="0.0005911 0.000546493 0.000155707"/>
              <joint name="forearm_roll" class="forearm_roll"/>
              <geom quat="0 1 0 0" class="visual" mesh="vx300s_5_lower_forearm"/>
              <body name="wrist_link" pos="0.1 0 0" gravcomp="1">
                <inertial pos="0.046743 -7.6652e-06 0.010565" quat="-0.00100191 0.544586 0.0026583 0.8387"
                  mass="0.115395" diaginertia="5.45707e-05 4.63101e-05 4.32692e-05"/>
                <joint name="wrist_angle" class="wrist_angle"/>
                <geom quat="1 0 0 1" class="visual" mesh="vx300s_6_wrist"/>
                <body name="gripper_link" pos="0.069744 0 0" gravcomp="1">
                  <inertial pos="0.0395662 -2.56311e-07 0.00400649" quat="0.62033 0.619916 -0.339682 0.339869"
                    mass="0.251652" diaginertia="0.000689546 0.000650316 0.000468142"/>
                  <joint name="wrist_rotate" class="wrist_rotate"/>
                  <geom pos="-0.02 0 0" quat="1 0 0 1" class="visual" mesh="vx300s_7_gripper"/>
                  <geom pos="-0.020175 0 0" quat="1 0 0 1" class="visual" mesh="vx300s_9_gripper_bar"/>
                  <site name="pinch" pos="0.1 0 0" size="0.005" rgba="0.6 0.3 0.3 1" group="5"/>
                  <!-- 손목(wrist) 카메라: gripper_link에 고정, 로컬 +x(peg가
                       뻗어나가는 방향, pinch 방향)를 바라본다. xyaxes로 카메라
                       -z(시선 방향)가 body +x가 되도록 맞췄다. -->
                  <camera name="wrist_cam" mode="fixed" pos="0.13 0.15 0" xyaxes="-1 0 0 0 0 1"/>
                  <body name="left_finger_link" pos="0.0687 0 0" gravcomp="1">
                    <inertial pos="0.017344 -0.0060692 0" quat="0.449364 0.449364 -0.54596 -0.54596" mass="0.034796"
                      diaginertia="2.48003e-05 1.417e-05 1.20797e-05"/>
                    <joint name="left_finger" class="left_finger"/>
                    <geom pos="-0.0404 -0.0575 0" quat="-1 1 -1 1" class="visual" mesh="vx300s_10_gripper_finger"/>
                  </body>
                  <body name="right_finger_link" pos="0.0687 0 0" gravcomp="1">
                    <inertial pos="0.017344 0.0060692 0" quat="0.44937 -0.44937 0.545955 -0.545955" mass="0.034796"
                      diaginertia="2.48002e-05 1.417e-05 1.20798e-05"/>
                    <joint name="right_finger" class="right_finger"/>
                    <geom pos="-0.0404 0.0575 0" quat="1 1 1 1" class="visual" mesh="vx300s_10_gripper_finger"/>
                  </body>
                  <!-- peg: gripper_link 자식이지만 자체 조인트가 없음 -> 그리퍼에 강체로
                       고정된 것으로 취급(grasp 자체는 다루지 않음). pinch site 위치에서
                       로컬 +x(핀치 방향)로 더 뻗어나간다. tip이 구형인 이유는 다른
                       ard-gen 모델과 동일 — 평평한 바닥은 접촉 normal이 항상 수직이라
                       admittance controller가 반응할 xy 힘 신호를 못 만든다. -->
                  <body name="peg" pos="0.13 0 0" gravcomp="1">
                    <geom class="peg_contact" name="peg_shaft" type="box" size="0.03 0.01 0.01" mass="0.04" rgba="0.95 0.35 0.05 1"/>
                    <geom class="peg_contact" name="peg_tip_ball" type="sphere" pos="0.03 0 0" size="0.01" mass="0.01" rgba="0.95 0.35 0.05 1"/>
                    <site name="peg_tip_site" pos="0.04 0 0" size="0.003" rgba="0 1 0 1"/>
                  </body>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>

    <!-- Stabilizer(왼팔) 가상 엔드이펙터: sim/stabilizer.py 공용 -- 실제 팔
         기구학(Jacobian IK)을 모델링하지 않고, world에 직접 매인 3-슬라이드
         조인트 점 하나로 표현한다. 이 프로젝트가 이미 grasp 물리 자체를
         모델링하지 않는 것(peg-그리퍼 결합, cap_twist의 wrist=힌지 직접
         구동)과 같은 선상의 단순화다 -- "IK 기반, 파라미터 탐색 불필요"를
         만족하려면 직렬 링크가 없어야 역기구학이 항등함수가 돼서 매 태스크마다
         홈 자세를 손으로 다시 풀 필요가 없어진다(assets/peg_in_hole_bimanual.xml
         의 이전 시도가 겪은 문제 -- 왼팔 홈 자세를 hole 위치마다 다시 계산해야
         해서 위치 무작위화를 포기했었음 -- 를 근본적으로 피한다).
         회전(orientation)은 액추에이트하지 않는다(고정, 항등) -- 두 태스크
         모두 물체를 특정 각도로 재배치할 필요가 없어서(hole_pose의 theta는
         아직 물리에 반영되지 않음, PIPELINE.md 참고), weld 시점에 물체의
         "현재" 방향을 그대로 굳히면 충분하다.
         pos="0 0 0"인 이유: 조인트 좌표(qpos)가 곧 world 절대 위치가 되도록
         (body 자체의 고정 오프셋이 있으면 qpos에 그 오프셋이 추가로 더해져서
         ctrl에 world 목표 좌표를 그대로 못 넣는다 -- sim/stabilizer.py 개발
         중 실측으로 확인한 버그, 자세한 내용은 그 파일 docstring 참고).
         damping=15/kp=400은 이 몸체 질량(0.1kg)에서 진동 없이 빠르게
         수렴하도록 실측으로 잡은 값이다(critical damping ~= 2*sqrt(kp*m)
         =2*sqrt(400*0.1)=12.6 근방). forcerange는 넉넉하게 커서 실제
         한계는 사실상 없다(가상 엔드이펙터라 실제 토크 제한이 의미 없음).

         ## kp를 올려도 못 구하는 실패 4건 (실측, 3단계 검증 결과)

         자유물체 전환 + Stabilizer 후 무작위 40씬 회귀에서, 원래(hole 완전
         고정) 성공하던 28개 중 24개는 그대로 성공하고 4개만 새로 실패한다
         (실패 원인: peg가 옆으로 크게 빗나가 벽 위에 걸린 채 400스텝 내내
         Z_RATE로 계속 눌러 100N+까지 힘이 쌓이는 경계선 케이스). kp를
         400->1500(거의 4배)으로 올려도 이 4건은 똑같이 실패했다 -- 위치
         액추에이터는 F=kp*(목표-현재)라 정적 평형에서 오차가 kp에 반비례로
         줄어들 뿐(약 110N/1500=73mm) 절대 0이 되지 않고, 이 정도로 큰 힘을
         받는 경계선 케이스에서는 그 잔류 변위조차 삽입을 갈라놓기에 충분하다.
         즉 이 4건의 실패는 Stabilizer/weld 강성 부족이 아니라, "hole이
         완전 강체가 아니게 되면" 실제로 달라지는 정당한 물리(경계선
         케이스의 미세한 wobble-in 동역학 변화)다 -- 실제 로봇에서도 아주
         뻑뻑하게 쥔 손이 여전히 미세하게 밀리는 것과 같다. kp를 과하게
         더 올리면(수만 단위) 이 timestep(0.002s)에서 수치적으로 불안정해질
         위험이 커서, 4개를 마저 구하려고 억지로 올리지 않았다. -->
    <body name="stabilizer_ee" pos="0 0 0">
      <joint name="stab_x" type="slide" axis="1 0 0" damping="15"/>
      <joint name="stab_y" type="slide" axis="0 1 0" damping="15"/>
      <joint name="stab_z" type="slide" axis="0 0 1" damping="15"/>
      <inertial pos="0 0 0" mass="0.1" diaginertia="1e-5 1e-5 1e-5"/>
      <geom name="stabilizer_ee_geom" type="sphere" size="0.012" contype="0" conaffinity="0" rgba="0.2 0.8 0.3 1"/>
      <site name="stabilizer_ee_site" pos="0 0 0" size="0.005"/>
    </body>
  </worldbody>

  <equality>
    <joint joint1="left_finger" joint2="right_finger" polycoef="0 -1 0 0 0"/>
    <!-- 활성화/relpose는 sim/stabilizer.py가 런타임에 채운다(접근 완료 시점의
         실제 상대 포즈를 그대로 굳힘) -- 컴파일 타임 값은 의미 없다.
         solref/solimp는 assets/peg_in_hole_bimanual.xml에서 실측 검증된
         값(약한 기본값으로는 오른팔 삽입 반작용에 밀림)을 그대로 가져왔다. -->
    <weld name="stabilizer_weld" body1="stabilizer_ee" body2="hole_socket"
          solref="0.002 1" solimp="0.95 0.99 0.0001 0.5 2" active="false"/>
  </equality>

  <actuator>
    <position name="stab_x" joint="stab_x" kp="400" forcerange="-500 500"/>
    <position name="stab_y" joint="stab_y" kp="400" forcerange="-500 500"/>
    <position name="stab_z" joint="stab_z" kp="400" forcerange="-500 500"/>
  </actuator>

  <actuator>
    <position class="waist" name="waist" joint="waist"/>
    <position class="shoulder" name="shoulder" joint="shoulder"/>
    <position class="elbow" name="elbow" joint="elbow"/>
    <position class="forearm_roll" name="forearm_roll" joint="forearm_roll"/>
    <position class="wrist_angle" name="wrist_angle" joint="wrist_angle"/>
    <position class="wrist_rotate" name="wrist_rotate" joint="wrist_rotate"/>
    <position class="finger" name="gripper" joint="left_finger"/>
  </actuator>

  <contact>
    <exclude body1="base_link" body2="shoulder_link"/>
  </contact>

  <sensor>
    <force name="peg_force" site="peg_tip_site"/>
    <torque name="peg_torque" site="peg_tip_site"/>
  </sensor>
</mujoco>
